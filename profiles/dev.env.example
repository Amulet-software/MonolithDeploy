DEPLOY_PROFILE=dev
DEPLOY_ENABLED=true
SITE_BIND_IP=192.168.1.32
SITE_PORT=80
HUB_BIND_IP=192.168.1.32
HUB_PORT=8080
SITE_PUBLIC_URL=http://192.168.1.32
HUB_PUBLIC_BASE_URL=http://192.168.1.32:8080
SITE_ENABLE_DEVELOPMENT=true
HUB_CORS_ORIGINS=["http://192.168.1.32"]
HUB_ENVIRONMENT=development
POSTGRES_PASSWORD=change-me
HUB_ADMIN_KEY=change-me

# Private repository access.
# DEV uses three repository-scoped read-only SSH deploy keys configured by
# deploy-key-setup.sh. GITHUB_TOKEN_FILE remains as an emergency HTTPS fallback only.
GITHUB_TOKEN_FILE=
HUB_REPOSITORY=git@github-hub-monolith:Amulet-software/HubMonolith.git
HUB_REF=main
SITE_REPOSITORY=git@github-site-monolit:Amulet-software/SiteMonolit.git
SITE_REF=main

HUB_REQUIRE_SIGNED_MONMOD=true
HUB_AUTO_SEED=false
HUB_LOG_LEVEL=INFO
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
